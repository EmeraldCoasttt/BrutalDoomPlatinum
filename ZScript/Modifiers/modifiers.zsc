enum BDP_Modifiers
{
	Modifier_StayFrosty		= 1 << 0,
	Modifier_Chatterbox		= 1 << 1,
	Modifier_Triathlon		= 1 << 2,
	Modifier_OneUpmanship	= 1 << 3,
	Modifier_UltraNightmare	= 1 << 4,
	Modifier_SkullCrusher	= 1 << 5,
	Modifier_ScoreMaster	= 1 << 6,
	Modifier_ShockFactor	= 1 << 7,
	Modifier_PerfectHatred	= 1 << 8,
	Modifier_Realism		= 1 << 9,
	Modifier_Gunslinger		= 1 << 10,
	Modifier_SequenceBreak	= 1 << 11,
	Modifier_Fragger		= 1 << 12,
	Modifier_Gluttony		= 1 << 13,
	Modifier_KickInTheHead	= 1 << 14
}

class BDP_ModifierStayFrosty : BDP_Modifier
{
	Default
	{
		BDP_Modifier.Icon "STFROST";
		BDP_Modifier.DisplayName "Stay Frosty";
		BDP_Modifier.Description "Athletic actions require Stamina";
		BDP_Modifier.ModifierID Modifier_StayFrosty;
	}
}

class BDP_ModifierChatterbox : BDP_Modifier
{
	Default
	{
		BDP_Modifier.Icon "STCHAT";
		BDP_Modifier.DisplayName "Chatterbox";
		BDP_Modifier.Description "Doomguy says one liners automatically";
		BDP_Modifier.ModifierID Modifier_Chatterbox;
	}
	
	Override void worldthingdamaged(Worldevent e)
	{
		If(e.thing && e.thing.bisMonster && e.thing.health <= 0 && e.damagesource && e.damagesource is "BDP_PlayerPawn")
		{
			//console.printf(e.damagetype);
			//console.printf(e.damagesource.getclassname());
			 BDP_PlayerPawn BDPPlayer = BDP_PlayerPawn(e.damagesource);
			 If(e.damagetype == 'ExtremePunches')
			 {
				 If(BDPPlayer && !bdpplayer.tauntcooldown && random(1,3) > 1 )
				 {
					BDPPlayer.berserktaunt = true;
				 }
			 }
			 Else If(BDPPlayer && !bdpplayer.tauntcooldown && random(1,20) == 1)
			 {
				BDPPlayer.killtaunt = true;
				BDPPlayer.taunttimer = 15;
			 }
			
		}
		
	}


}

