class BDP_ModifierGunslinger : BDP_Modifier
{
	Default
	{
		BDP_Modifier.Icon "CIGST10";
		BDP_Modifier.DisplayName "Gunslinger";
		BDP_Modifier.Description "Weapons deselected for 5 or more seconds instantly reload";
	}
	
	override void WorldTick()
	{
		for(int i = 0; i < MAXPLAYERS; i++)
		{
			if(!PlayerInGame[i]) continue;
			PlayerInfo plr = players[i];
			if(!plr) continue;
			
			let dplr = BDP_PlayerPawn(plr.mo);
			if(!dplr) continue;
			
			for(let item = dplr.Inv; item.Inv; item = item.Inv)
			{
				let dweap = BDP_Weapon(item);
				if(!dweap) continue;
				dweap.gunslinger = true;
			}
		}
	}

}






