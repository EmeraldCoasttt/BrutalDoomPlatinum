class BDP_ModifierSkullCrusher : BDP_Modifier
{
	Default
	{
		BDP_Modifier.Icon "D4RST01";
		BDP_Modifier.DisplayName "Skullcrusher";
		BDP_Modifier.Description "HUD shows killstreaks";
		BDP_Modifier.ModifierID Modifier_SkullCrusher;
	}
	

	Override void worldthingdamaged(Worldevent e)
	{
		If(e.thing && e.thing.bisMonster && e.thing.health <= 0 && e.damagesource && e.damagesource is "BDP_PlayerPawn")
		{
			//console.printf(e.damagetype);
			//console.printf(e.damagesource.getclassname());
			 BDP_PlayerPawn BDPPlayer = BDP_PlayerPawn(e.damagesource);
			If(BDPPLAYER)
			{
				BDPPlayer.killstreak ++;
				BDPPlayer.killstreaktimer = 140;
			}
			 
			
		}
		
	}


}


class BDP_ModifierScoreMaster : BDP_Modifier
{
	Default
	{
		BDP_Modifier.Icon "STNERD";
		BDP_Modifier.DisplayName "Scoremaster";
		BDP_Modifier.Description "Gain points by killing monsters and collecting items\n\n 50k points grants an extra life";
		BDP_Modifier.ModifierID Modifier_ScoreMaster;
	}
	
	Override void worldthingdamaged(Worldevent e)
	{
		If(e.thing && e.thing.bisMonster && e.thing.health <= 0 && e.damagesource && e.damagesource is "BDP_PlayerPawn")
		{
			//console.printf(e.damagetype);
			//console.printf(e.damagesource.getclassname());
			 BDP_PlayerPawn BDPPlayer = BDP_PlayerPawn(e.damagesource);
			If(BDPPLAYER)
			{
				If(BDPPlayer.killstreak > 1)
				{
					double potentialscore = e.thing.getspawnhealth();
					double scoremodifier = (BDPPlayer.killstreak - 1);
					scoremodifier *= 0.1;
					scoremodifier += 1;
					potentialscore *= scoremodifier;
					//Console.printf("%d",potentialscore);
					BDPPlayer.score += potentialscore;
				}
				else
				{
					BDPPlayer.score += (e.thing.getspawnhealth());
				}
			}
			 
			
		}
		
	}


}

mixin class BDP_ScoreMixin
{
	int scoreAmount;
	property ScoreAmount : scoreAmount;
	
	int extraLives;
	property ExtraLives : extraLives;
	
	override bool TryPickup(in out Actor toucher)
	{
		if(super.TryPickup(toucher))
		{
			toucher.Score += scoreAmount;
			if(!extraLives) return true;
			BDP_PlayerPawn dplr = BDP_PlayerPawn(toucher);
			If(dplr && bdp_active_modifiers & Modifier_OneUpmanship)
				dplr.extralives += extraLives;
			return true;
		}
		return false;
	}
	
	override void PlayPickupSound(Actor toucher)
	{
		if(extraLives)
		{
			if(bdp_active_modifiers & Modifier_OneUpmanship) PickupSound = "1UP";
		}
		super.PlayPickupSound(toucher);
	}
}

class BDP_ModifierShockFactor : BDP_Modifier
{
	Default
	{
		BDP_Modifier.Icon "STSHOCK";
		BDP_Modifier.DisplayName "Shock Factor";
		BDP_Modifier.Description "Demons are hyper-aware of you";
		BDP_Modifier.ModifierID Modifier_ShockFactor;
	}
	
	Override void worldthingspawned(Worldevent e)
	{
		If(e.thing && e.thing.bismonster)
		{
			e.thing.bambush = false;
		}
	}
	
}


class BDP_ModifierPerfectHatred : BDP_Modifier
{
	Default
	{
		BDP_Modifier.Icon "FC0OUCH4";
		BDP_Modifier.DisplayName "Perfect Hatred";
		BDP_Modifier.Description "Demons are permanently enraged";
		BDP_Modifier.ModifierID Modifier_PerfectHatred;
	}
	
	Override void worldthingspawned(Worldevent e)
	{
		If(e.thing && e.thing.bismonster)
		{
			e.thing.MissileChanceMult *= 0.5;
			//e.thing.bmissileevenmore = true;
			e.thing.speed = (e.thing.speed * 1.5);
			e.thing.bnopain = true;
			e.thing.bnoinfighting = TRUE;
			e.thing.giveinventory("pissedarmor",1);
			//e.thing.A_giveinventory("thisreallypissesmeoff",(e.thing.health / 70));
		}
	}
	
}

