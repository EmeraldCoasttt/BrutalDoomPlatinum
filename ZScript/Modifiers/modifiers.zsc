class BDP_ModifierOneUpmanship : BDP_Modifier
{
	Default
	{
		BDP_Modifier.Icon "BJBST00";
		BDP_Modifier.DisplayName "One-Upmanship";
		BDP_Modifier.Description "Soul Spheres grant extra lives";
	}
	Override void worldthingspawned(Worldevent e)
	{
	If(e.thing && e.thing.getclassname() == "BDP_Soulsphere")
		{
			Actor.spawn("BDP_SoulsphereOneUp",e.thing.pos);
			E.thing.destroy();
		}
		
	If(e.thing  && e.thing.getclassname() == "BDP_Megasphere")
		{
			Actor.spawn("BDP_MegasphereOneUp",e.thing.pos);
			E.thing.destroy();
		}
	
	}
	override void WorldTick()
	{
		for(int i = 0; i < MAXPLAYERS; i++)
		{
			if(!PlayerInGame[i]) continue;
			PlayerInfo plr = players[i];
			if(!plr) continue;
			
			let dplr = BDP_PlayerPawn(plr.mo);
			if(!dplr) continue;
			
			dplr.oneupmanship = true;
		}
	}

}

