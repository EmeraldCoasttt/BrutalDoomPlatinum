class BDP_ModifierSpawner : randomspawner
{
	Default
	{
		Dropitem "BDP_FraggerPickup";
		Dropitem "BDP_ShockFactorPickup";
		Dropitem "BDP_PerfectHatredPickup";
		Dropitem "BDP_GunSlingerPickup";
		Dropitem "BDP_OneUpmanshipPickup";
		Dropitem "BDP_UltraNightmarePickup";
		Dropitem "BDP_SequenceBreakPickup";
		Dropitem "BDP_SkullcrusherPickUp";
		Dropitem "BDP_ScoreMasterPickUp";
		Dropitem "BDP_RealismPickUp";
		Dropitem "BDP_GluttonyPickUp";
		Dropitem "BDP_KickintheHeadPickUp";
	}
}
class BDP_ModifierPickup : Inventory
{
	int ModifierID;
	property ModifierID : ModifierID;
	string modifiermessage;
	property modifiermessage : modifiermessage;
    Default
    {
        Inventory.MaxAmount 666;
		BDP_ModifierPickup.ModifierID 0;
		Inventory.pickupsound "null";
		Inventory.pickupmessage "You got a Modifier!";
		BDP_ModifierPickup.modifiermessage "YOU SHOULDN'T BE SEEING THIS";
		+BRIGHT;
    }

    static void UnlockModifier(int ModifierID)
    {
		// This should be a Server CVar, so we should be able to use consoleplayer.
		let sv_unlockedmods = CVar.GetCVar("bdp_unlocked_modifiers", players[consoleplayer]);
		int modInt = sv_unlockedmods.GetInt();
		modInt |= ModifierID;
		sv_unlockedmods.SetInt(modInt);
    }

    override void AttachToOwner(Actor other)
    {
        UnlockModifier(ModifierID);
		other.A_startsound("MODSTING",720,0,1.0,ATTN_NONE);
		other.A_Print(modifiermessage,5);
		EventHandler.SendNetworkEvent("flag_updatemodifierstatus");
        super.AttachToOwner(other);
		
    }
    
    States
    {
        Spawn:
            MODD A -1;
        stop;
    }
}

class BDP_FraggerPickup : BDP_ModifierPickup
{
 Default
    {
        
		BDP_ModifierPickup.ModifierID Modifier_Fragger;
		translation "200:207=[117,117,117]:[0,0,0]","240:247=244:247";
		BDP_ModifierPickup.modifiermessage "Fragger Unlocked!";
		+floatbob;
    }
}

